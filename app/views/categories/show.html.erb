<h1><%= @category.name %></h1>
<ul>
  <% @category.recipes.each do |recipe| %>
    <li>
      <%= recipe.name %> | <%= link_to 'Delete', category_bookmark_path(@category, recipe.bookmarks.find_by(category: @category)), method: :delete, data: { confirm: 'Are you sure?' } %>
    </li>
  <% end %>
</ul>
<%= link_to 'Add Recipe', new_category_bookmark_path(@category) %>
<%= link_to 'Back to Categories', categories_path %>
