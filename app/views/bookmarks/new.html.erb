<h1>Add Recipe to <%= @category.name %></h1>
<%= form_with(model: [@category, @bookmark], local: true) do |form| %>
  <div class="field">
    <%= form.label :recipe_id, "Recipe" %>
    <%= form.collection_select :recipe_id, Recipe.all, :id, :name %>
  </div>
  <div class="field">
    <%= form.label :comment %>
    <%= form.text_area :comment %>
  </div>
  <div class="actions">
    <%= form.submit 'Add Recipe', class: 'btn btn-primary' %>
  </div>
<% end %>
<%= link_to 'Back to Category', category_path(@category) %>
